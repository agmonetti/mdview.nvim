#!/usr/bin/env bash
set -euo pipefail
root=$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
theme=${1:?usage: manual-theme dark|light|nvim [document.md]}
case "$theme" in dark|light|nvim) ;; *) echo "Unknown theme: $theme" >&2; exit 2;; esac
if [[ -n ${SSH_CLIENT-}${SSH_TTY-}${SSH_CONNECTION-}${TMUX-} || ( ${TERM-} != xterm-kitty && -z ${KITTY_WINDOW_ID-} ) ]]; then
  echo 'Run inside local Kitty, outside SSH/tmux.' >&2; exit 1
fi
[[ -x $root/build/mdview-preview ]] || { echo 'Build first with ./scripts/build.sh' >&2; exit 1; }
if [[ -n ${2-} ]]; then
  document=$2
else
  fixture=$(mktemp -d /tmp/mdview-theme.XXXXXX)
  trap 'rm -rf -- "$fixture"' EXIT
  magick -size 64x32 gradient:'#0969da-#fafafa' "$fixture/local.png"
  cat "$root/examples/demo.md" > "$fixture/document.md"
  printf '\nInline `code` and a separator:\n\n---\n\n![Local image](local.png)\n' >> "$fixture/document.md"
  document=$fixture/document.md
fi
[[ -f $document ]] || { echo "Missing document: $document" >&2; exit 1; }
export MDVIEW_MANUAL_ROOT=$root MDVIEW_MANUAL_THEME=$theme
nvim "$document" -c 'lua vim.opt.runtimepath:prepend(vim.env.MDVIEW_MANUAL_ROOT); package.loaded["mdview"]=nil; require("mdview").setup({theme=vim.env.MDVIEW_MANUAL_THEME,raw=false,smooth=false,zbelow=false,clamp=false}); require("mdview").open("split")'
