#!/usr/bin/env bash
set -euo pipefail
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
results="$root/build/merman-evaluation/results"
mode=${1:-split}
case "$mode" in
  replace|split)
    if [[ -n ${SSH_CLIENT-}${SSH_TTY-}${SSH_CONNECTION-}${TMUX-} || ( ${TERM-} != xterm-kitty && -z ${KITTY_WINDOW_ID-} ) ]]; then
      printf '%s\n' 'Run inside local Kitty, outside SSH/tmux.' >&2; exit 1
    fi
    [[ -x "$root/build/mdview-preview" ]] || { printf '%s\n' 'Build first with ./scripts/build.sh' >&2; exit 1; }
    binary="$root/build/merman-evaluation/target/release/merman-cli"
    [[ -x "$binary" ]] || { printf '%s\n' 'Build the authorized evaluation first with scripts/build-merman-evaluation; no automatic download/build.' >&2; exit 1; }
    if [[ -n ${2-} ]]; then
      fixture=$2
      [[ -f "$fixture" ]] || { printf 'Document not found: %s\n' "$fixture" >&2; exit 1; }
    else
      fixture=$(mktemp /tmp/mdview-merman-XXXXXX.md)
      trap 'rm -f -- "$fixture"' EXIT
      {
        printf '# Automatic Mermaid — unchanged reference ER\n\nEdit a label without saving, introduce and correct an error, scroll, resize, then close/reopen. The graph maps to its whole source block.\n\n```mermaid\n'
        cat "$root/tests/merman/reference.mmd"
        printf '\n```\n\n## Cardinality and Unicode boundary\n\n```mermaid\n'
        cat "$root/tests/merman/boundary.mmd"
        printf '\n```\n\n## End\n\nNo exported images or source rewriting.\n'
      } > "$fixture"
    fi
    export MDVIEW_MANUAL_ROOT=$root MDVIEW_MANUAL_MODE=$mode MDVIEW_MANUAL_MERMAN=$binary
    printf 'Opening automatic Mermaid in mdview %s mode; normal Neovim configuration is preserved. Use :qall! to discard unsaved probe edits.\n' "$mode"
    nvim "$fixture" -c 'lua vim.opt.runtimepath:prepend(vim.env.MDVIEW_MANUAL_ROOT); require("mdview").setup({split_follow="cursor",mermaid={renderer=vim.env.MDVIEW_MANUAL_MERMAN}}); require("mdview").open(vim.env.MDVIEW_MANUAL_MODE)'
    ;;
  light|dark)
    theme=default
    [[ "$1" != dark ]] || theme=dark
    [[ -f "$results/reference-$theme-672.png" ]] || { printf '%s\n' 'Run python3 tests/merman/evaluate.py first.' >&2; exit 1; }
    kitten icat "$results/reference-$theme-672.png"
    ;;
  *) printf 'Usage: %s [replace|split|light|dark] [document.md]\n' "$0" >&2; exit 2 ;;
esac
