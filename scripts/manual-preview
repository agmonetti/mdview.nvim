#!/usr/bin/env bash
set -euo pipefail
root=$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
variant=${1:?usage: manual-preview base|fluid|layers [document.md]}
shift
case "$variant" in base|fluid|layers) ;; *) echo "Unknown variant: $variant" >&2; exit 2;; esac
if [[ -n ${SSH_CLIENT-}${SSH_TTY-}${SSH_CONNECTION-}${TMUX-} || ( ${TERM-} != xterm-kitty && -z ${KITTY_WINDOW_ID-} ) ]]; then
  echo 'Run inside local Kitty, outside SSH/tmux.' >&2; exit 1
fi
document=${1:-"$root/README.md"}
[[ -f $document ]] || { echo "Missing document: $document" >&2; exit 1; }
[[ -x $root/build/mdview-preview ]] || { echo 'Build first with ./scripts/build.sh' >&2; exit 1; }
# Normal Neovim configuration supplies image.nvim; isolate only experimental flags.
unset FPLOG_RAW FPLOG_RAW_ZBELOW FPLOG_SMOOTH FPLOG_SMOOTH_FACTOR FPLOG_SMOOTH_INTERVAL FPLOG_CLAMP FPLOG_CLAMP_PX FPLOG_P3 FPLOG_STEP FPLOG_C
export MDVIEW_MANUAL_ROOT=$root MDVIEW_MANUAL_VARIANT=$variant
[[ $variant != layers ]] || export FPLOG_RAW_ZBELOW=1
exec nvim "$document" -c 'lua dofile(vim.env.MDVIEW_MANUAL_ROOT .. "/tests/bench/manual.lua")'
